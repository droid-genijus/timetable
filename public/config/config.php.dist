<?php

declare(strict_types=1);

/**
 * Copy this file to config.php and fill in real values for local dev.
 * In production, config.php is generated by the deploy workflow from
 * GitHub Secrets and is never committed (see .gitignore).
 */
return [
    'app_env' => '%%APP_ENV%%',
    'db_host' => '%%DB_HOST%%',
    'db_port' => '%%DB_PORT%%',
    'db_name' => '%%DB_DATABASE%%',
    'db_user' => '%%DB_USER%%',
    'db_pass' => '%%DB_PASSWORD%%',
];
